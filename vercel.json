{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "redirects": [
    {
      "source": "/estagio",
      "destination": "/empresas/estagio",
      "statusCode": 301
    },
    {
      "source": "/estagio/",
      "destination": "/empresas/estagio",
      "statusCode": 301
    },
    {
      "source": "/vagas/estagio",
      "destination": "/empresas/estagio",
      "statusCode": 301
    },
    {
      "source": "/vagas/estagio/",
      "destination": "/empresas/estagio",
      "statusCode": 301
    },
    {
      "source": "/pcd",
      "destination": "/empresas/inclusao-pcd",
      "statusCode": 301
    },
    {
      "source": "/pcd/",
      "destination": "/empresas/inclusao-pcd",
      "statusCode": 301
    },
    {
      "source": "/vagas/pcd",
      "destination": "/empresas/inclusao-pcd",
      "statusCode": 301
    },
    {
      "source": "/vagas/pcd/",
      "destination": "/empresas/inclusao-pcd",
      "statusCode": 301
    }
  ]
}
