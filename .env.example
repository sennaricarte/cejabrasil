# Variáveis de ambiente do backend de leads (POST /api/lead).
# Defina na Vercel: Project Settings > Environment Variables (Production).
# NUNCA commite valores reais. Detalhes e passo a passo em docs/leads.md.

# --- Destino 1: e-mail via Resend (ative definindo as TRÊS variáveis) ---
RESEND_API_KEY=
# Um ou mais destinatários, separados por vírgula (ex.: parcerias@cejabrasil.org.br)
LEADS_EMAIL_TO=
# Remetente de um domínio verificado na Resend, ex.: Site CEJA <site@cejabrasil.org.br>
LEADS_EMAIL_FROM=

# --- Destino 2: webhook (Google Sheets via Apps Script, Zapier, Make, n8n...) ---
LEADS_WEBHOOK_URL=
# Opcional: enviado no cabeçalho X-Webhook-Secret (Apps Script não lê cabeçalhos: use ?secret=... na URL)
LEADS_WEBHOOK_SECRET=

# --- Opcional ---
# Origens extras aceitas (separadas por vírgula), ex.: um preview da Vercel para testes
LEADS_ALLOWED_ORIGINS=
